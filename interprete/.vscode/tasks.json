{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build (make, debug)",
      "type": "shell",
      "command": "make",
      "args": ["-j", "debug"],
      "problemMatcher": ["$gcc"],
      "group": { "kind": "build", "isDefault": true }
